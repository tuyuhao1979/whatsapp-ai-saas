{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": ["jest", "node"],
    "rootDir": ".",
    "outDir": "dist-test"
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  // `exclude` is inherited from tsconfig.json, which excludes `tests` — so the
  // inherited value shadowed the `include` above and no test file belonged to
  // any project. Type-aware linting and `ts-jest` type checking then failed with
  // "ESLint was configured to run on ... using parserOptions.project: however,
  // none of those TSConfigs include this file".
  "exclude": ["node_modules", "dist", "dist-test"]
}
